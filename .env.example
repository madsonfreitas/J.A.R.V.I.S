# Nunca adicione uma chave real neste arquivo.
# Ausente ou anthropic preserva o provedor atual. gemini usa somente o Gemini.
JARVIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Vazio usa claude-sonnet-5 no caminho Anthropic e gemini-3.8-flash no caminho Gemini.
JARVIS_MODEL=
JARVIS_DATA_DIR=.jarvis
JARVIS_MAX_SOURCE_BYTES=1000000
JARVIS_MAX_TOTAL_CHARS=100000
