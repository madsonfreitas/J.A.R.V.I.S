# Nunca adicione uma chave real neste arquivo.
# Ausente ou anthropic preserva o provedor atual. gemini e groq usam somente o provedor escolhido.
JARVIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# groq exige esta chave e um JARVIS_MODEL explícito. Não há modelo padrão para Groq.
GROQ_API_KEY=
# Vazio usa claude-sonnet-5 no Anthropic e gemini-3.8-flash no Gemini.
# Para groq, JARVIS_MODEL é obrigatório.
JARVIS_MODEL=
JARVIS_DATA_DIR=.jarvis
JARVIS_MAX_SOURCE_BYTES=1000000
JARVIS_MAX_TOTAL_CHARS=100000
